# Vite exposes every VITE_* variable to the browser.
# Only put public, safe-to-share settings in this file.
# Never add API keys, tokens, passwords, or private secrets here.

# Site domain used for canonical URLs, robots.txt, and sitemap.xml.
VITE_SITE_URL=https://example.com

# Brand text shown in the header and browser titles.
VITE_BRAND_NAME=Pulse Studio
VITE_BRAND_HOME_URL=/
VITE_TITLE_SUFFIX=Pulse Studio

# Repository links used on the "Use This Template" page.
VITE_TEMPLATE_GITHUB_URL=https://github.com/CookieShualon/animated-landing-page
VITE_TEMPLATE_CLONE_URL=https://github.com/CookieShualon/animated-landing-page.git
VITE_TEMPLATE_DISABLED_REDIRECT=/

# Contact form display values.
VITE_CONTACT_EMAIL=hello@example.com
VITE_CONTACT_EMAIL_PLACEHOLDER=you@example.com

# Theme colors applied as CSS variables at runtime.
VITE_THEME_ACCENT=#7dd3fc
VITE_THEME_ACCENT_STRONG=#f97316
VITE_THEME_GREEN=#a3e635

# Page toggles. Set any value to false to hide/disable that page.
VITE_ENABLE_PRICING_PAGE=true
VITE_ENABLE_TEMPLATE_PAGE=true
VITE_ENABLE_CONTACT_PAGE=true

# Animation toggles.
VITE_ENABLE_CINEMATIC_SCROLL=true
VITE_ENABLE_COUNTERS=true
VITE_ENABLE_VISUAL_ACCENTS=true
